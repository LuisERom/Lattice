# Copy this file to ".env" and fill in your key. The Python generator loads it
# automatically. The .env file is git-ignored, so your key stays local.

OPENAI_API_KEY=sk-your-key-here

# Optional overrides:
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint
# LATTICE_GEN_MODEL=gpt-4o-mini
# LATTICE_GEN_MODEL_FAST=gpt-4o-mini
#
# Embeddings for Phase C/E2 (Doc 4 pipeline):
# VOYAGE_API_KEY=voyage-your-key-here
# VOYAGE_BASE_URL=https://api.voyageai.com/v1
# VOYAGE_MODEL=voyage-3-lite
#
# Offline harness (no external API calls):
# LATTICE_FAKE_LLM=1
